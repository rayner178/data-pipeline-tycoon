# Copia este archivo como .env y completa los valores.
# .env está en .gitignore: nunca lo subas al repositorio.

# PostgreSQL local (docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Cadena de conexión SQLAlchemy / Alembic (PostgreSQL)
# Local (Docker): postgresql+psycopg://USER:PASSWORD@localhost:5432/DB
# Producción (Neon directo, sin "-pooler"): postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Opcional: conexión con rol de permisos mínimos pre-creado para el sandbox SQL.
# - En local/Docker déjalo vacío para aprovisionamiento automático de `tycoon_sandbox_player`.
# - En Neon/PostgreSQL gestionado puedes indicar el rol restringido con SSL:
#   postgresql://tycoon_sandbox_player:SANDBOX_PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
SANDBOX_DATABASE_URL=

# Clave secreta compartida entre el servidor de Roblox y la API (X-API-Key)
API_KEY=
